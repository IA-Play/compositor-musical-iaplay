{
  "daemon": true,
  "run": [
    {
      "method": "shell.run",
      "params": {
        "message": "npm run dev -- --host 127.0.0.1 --port {{port}}",
        "on": [{ "event": "/(http:\\/\\/[a-zA-Z0-9.:_-]+)/", "done": true }]
      }
    },
    {
      "method": "local.set",
      "params": {
        "url": "{{input.event[1]}}"
      }
    }
  ]
}


