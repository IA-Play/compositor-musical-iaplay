{
  "daemon": true,
  "run": [
    {
      "when": "{{!exists('node_modules')}}",
      "method": "shell.run",
      "params": {
        "message": "npm install"
      }
    },
    {
      "when": "{{!exists('env')}}",
      "method": "shell.run",
      "params": {
        "message": [
          "uv venv env --python 3.11 || uv venv env || python -m venv env"
        ]
      }
    },
    {
      "when": "{{platform === 'win32' && exists('server/yue_server.py')}}",
      "method": "shell.run",
      "params": {
        "venv": "env",
        "venv_python": "3.11",
        "env": {
          "PIP_REQUIRE_VIRTUALENV": "false",
          "PIP_NO_REQUIRE_VIRTUALENV": "1"
        },
        "message": "server\\start_server.bat",
        "on": [{ "event": "/(Iniciando servidor dedicado YuE2|Servidor dedicado YuE2 ja esta ativo|Uvicorn running on|127\\.0\\.0\\.1:42024|Application startup complete)/i", "done": true }]
      }
    },
    {
      "when": "{{platform !== 'win32' && exists('server/yue_server.py')}}",
      "method": "shell.run",
      "params": {
        "venv": "env",
        "venv_python": "3.11",
        "env": {
          "PIP_REQUIRE_VIRTUALENV": "false",
          "PIP_NO_REQUIRE_VIRTUALENV": "1"
        },
        "message": "python server/yue_server.py --port 42024 --host 127.0.0.1",
        "on": [{ "event": "/(Iniciando servidor dedicado YuE2|Servidor dedicado YuE2 ja esta ativo|Uvicorn running on|127\\.0\\.0\\.1:42024|Application startup complete)/i", "done": true }]
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "npm run dev -- --host 127.0.0.1 --port {{port}}",
        "on": [{ "event": "/(http:\\/\\/[0-9.:]+)/", "done": true }]
      }
    },
    {
      "method": "local.set",
      "params": {
        "url": "{{input.event[1]}}"
      }
    }
  ]
}
