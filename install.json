{
  "requires": {
    "bundle": "ai"
  },
  "run": [
    {
      "when": "{{exists('.installed')}}",
      "method": "fs.rm",
      "params": {
        "path": ".installed"
      }
    },
    {
      "when": "{{!args || !args.mode}}",
      "method": "input",
      "params": {
        "title": "Modo de Instalação do IAPLAY Studio",
        "description": "Escolha como deseja instalar o IAPLAY Studio. No Modo Leve você instala apenas o Criador de Letras e Prompts (Suno, Udio, Mureka) em poucos segundos, podendo baixar o motor musical YuE2 (~6 GB) depois quando quiser.",
        "form": [
          {
            "type": "select",
            "key": "mode",
            "title": "Selecione o pacote de instalação",
            "default": "full",
            "items": [
              {
                "text": "Modo Completo — Criador de Letras/Prompts + Estúdio Musical YuE2 Local (~6 GB, NVIDIA / AMD / CPU)",
                "value": "full"
              },
              {
                "text": "Modo Leve / Rápido — Apenas Criador de Letras e Prompts (Suno, Udio, Mureka) — Sem baixar 6 GB",
                "value": "lite"
              }
            ]
          }
        ]
      }
    },
    {
      "method": "local.set",
      "params": {
        "mode": "{{args && ('' + args.mode).includes('lite') ? 'lite' : (input && input.mode === 'lite' ? 'lite' : 'full')}}"
      }
    },
    {
      "method": "fs.write",
      "params": {
        "path": ".iaplay_mode",
        "text": "{{local.mode}}"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": [
          "npm install",
          "npm run build"
        ]
      }
    },
    {
      "when": "{{!exists('env')}}",
      "method": "shell.run",
      "params": {
        "message": [
          "uv venv env --python 3.11 || uv venv env || python -m venv env"
        ]
      }
    },
    {
      "when": "{{local.mode === 'lite'}}",
      "method": "shell.run",
      "params": {
        "venv": "env",
        "venv_python": "3.11",
        "env": {
          "UV_NATIVE_TLS": "true",
          "UV_SYSTEM_CERTS": "true",
          "PIP_REQUIRE_VIRTUALENV": "false",
          "PIP_NO_REQUIRE_VIRTUALENV": "1"
        },
        "message": [
          "uv pip install fastapi uvicorn pydantic soundfile numpy==1.26.4 requests huggingface_hub packaging psutil"
        ]
      }
    },
    {
      "when": "{{local.mode !== 'lite'}}",
      "method": "shell.run",
      "params": {
        "venv": "env",
        "venv_python": "3.11",
        "env": {
          "UV_NATIVE_TLS": "true",
          "UV_SYSTEM_CERTS": "true",
          "PIP_REQUIRE_VIRTUALENV": "false",
          "PIP_NO_REQUIRE_VIRTUALENV": "1"
        },
        "message": [
          "uv pip install -r server/requirements.txt --index-strategy unsafe-best-match"
        ]
      }
    },
    {
      "when": "{{local.mode !== 'lite' && platform === 'win32' && gpu === 'nvidia'}}",
      "method": "shell.run",
      "params": {
        "venv": "env",
        "venv_python": "3.11",
        "env": {
          "UV_NATIVE_TLS": "true",
          "UV_SYSTEM_CERTS": "true",
          "PIP_REQUIRE_VIRTUALENV": "false",
          "PIP_NO_REQUIRE_VIRTUALENV": "1"
        },
        "message": [
          "uv pip install typing-extensions>=4.10.0",
          "uv pip install torch==2.8.0 torchaudio==2.8.0 torchvision==0.23.0 --index-url https://download.pytorch.org/whl/cu128 --force-reinstall"
        ]
      }
    },
    {
      "when": "{{local.mode !== 'lite' && platform === 'linux' && gpu === 'nvidia'}}",
      "method": "shell.run",
      "params": {
        "venv": "env",
        "venv_python": "3.11",
        "env": {
          "UV_NATIVE_TLS": "true",
          "UV_SYSTEM_CERTS": "true",
          "PIP_REQUIRE_VIRTUALENV": "false",
          "PIP_NO_REQUIRE_VIRTUALENV": "1"
        },
        "message": [
          "uv pip install typing-extensions>=4.10.0",
          "uv pip install torch==2.8.0 torchaudio==2.8.0 torchvision==0.23.0 --index-url https://download.pytorch.org/whl/cu128 --force-reinstall"
        ]
      }
    },
    {
      "when": "{{local.mode !== 'lite' && platform === 'win32' && gpu === 'amd'}}",
      "method": "shell.run",
      "params": {
        "venv": "env",
        "venv_python": "3.11",
        "env": {
          "UV_NATIVE_TLS": "true",
          "UV_SYSTEM_CERTS": "true",
          "PIP_REQUIRE_VIRTUALENV": "false",
          "PIP_NO_REQUIRE_VIRTUALENV": "1"
        },
        "message": [
          "uv pip install torch torch-directml torchaudio torchvision numpy==1.26.4 --force-reinstall"
        ]
      }
    },
    {
      "when": "{{local.mode !== 'lite' && platform === 'darwin' && arch === 'arm64'}}",
      "method": "shell.run",
      "params": {
        "venv": "env",
        "venv_python": "3.11",
        "env": {
          "UV_NATIVE_TLS": "true",
          "UV_SYSTEM_CERTS": "true",
          "PIP_REQUIRE_VIRTUALENV": "false",
          "PIP_NO_REQUIRE_VIRTUALENV": "1"
        },
        "message": [
          "uv pip install torch torchvision torchaudio"
        ]
      }
    },
    {
      "when": "{{local.mode !== 'lite' && gpu !== 'nvidia' && gpu !== 'amd' && !(platform === 'darwin' && arch === 'arm64')}}",
      "method": "shell.run",
      "params": {
        "venv": "env",
        "venv_python": "3.11",
        "env": {
          "UV_NATIVE_TLS": "true",
          "UV_SYSTEM_CERTS": "true",
          "PIP_REQUIRE_VIRTUALENV": "false",
          "PIP_NO_REQUIRE_VIRTUALENV": "1"
        },
        "message": [
          "uv pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu --force-reinstall"
        ]
      }
    },
    {
      "when": "{{local.mode !== 'lite'}}",
      "method": "shell.run",
      "params": {
        "venv": "env",
        "venv_python": "3.11",
        "message": [
          "python server/download_models.py"
        ]
      }
    },
    {
      "method": "fs.write",
      "params": {
        "path": ".installed",
        "text": "ok"
      }
    },
    {
      "when": "{{local.mode === 'lite'}}",
      "method": "notify",
      "params": {
        "html": "Instalação Rápida (Modo Leve) concluída! O Criador de Letras e Prompts está pronto. Se quiser usar o Estúdio Musical YuE2 no futuro, basta clicar em 'Baixar Modelos YuE2'."
      }
    },
    {
      "when": "{{local.mode !== 'lite'}}",
      "method": "notify",
      "params": {
        "html": "Instalação Completa do IAPLAY Studio concluída com sucesso! Todos os pacotes e modelos neurais YuE2 foram instalados. Clique em 'Iniciar IAPLAY'."
      }
    }
  ]
}
