{
  "run": [
    {
      "method": "fs.write",
      "params": {
        "path": ".iaplay_mode",
        "text": "full"
      }
    },
    {
      "when": "{{!exists('env')}}",
      "method": "shell.run",
      "params": {
        "message": [
          "uv venv env --python 3.11 || uv venv env || python -m venv env"
        ]
      }
    },
    {
      "method": "shell.run",
      "params": {
        "venv": "env",
        "venv_python": "3.11",
        "env": {
          "PIP_REQUIRE_VIRTUALENV": "false",
          "PIP_NO_REQUIRE_VIRTUALENV": "1"
        },
        "message": [
          "uv pip install -r server/requirements.txt --index-strategy unsafe-best-match"
        ]
      }
    },
    {
      "method": "script.start",
      "params": {
        "uri": "torch.js",
        "params": {
          "venv": "env",
          "venv_python": "3.11"
        }
      }
    },
    {
      "when": "{{platform === 'win32'}}",
      "method": "shell.run",
      "params": {
        "message": "server\\download_models.bat"
      }
    },
    {
      "when": "{{platform !== 'win32'}}",
      "method": "shell.run",
      "params": {
        "venv": "env",
        "message": "python server/download_models.py"
      }
    },
    {
      "method": "notify",
      "params": {
        "html": "Modelos neurais YuE2 3B e SheetSage2 + PyTorch (NVIDIA/AMD/CPU) configurados com sucesso no IAPLAY!"
      }
    }
  ]
}
